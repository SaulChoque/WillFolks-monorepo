// WillFolks · modelo de datos en DBML (https://dbml.dbdiagram.io)
// Pegar en https://dbdiagram.io/d para ver el diagrama.
// La fuente de verdad es sql/01_schema.sql; este archivo la refleja.

Project willfolks {
  database_type: 'PostgreSQL'
  Note: 'Metas con apuesta: usuarios, amistades, metas y su configuración por tipo, check-ins, evidencias, uso de apps, billetera, notificaciones y mascota.'
}

Enum auth_provider { dev; google; facebook; twitter }
Enum theme_id { acid; void }
Enum device_platform { android; ios; web }
Enum location_access { none; foreground; background }
Enum friendship_status { pending; accepted; declined; blocked }
Enum goal_kind { alarm; app_timer; locator; ai }
Enum goal_status { draft; active; paused; completed; failed; cancelled }
Enum group_mode { coop; vs }
Enum goal_verifier { ai; friend }
Enum participant_role { owner; participant; judge }
Enum participant_status { invited; accepted; declined; left }
Enum checkin_result { pending; success; fail }
Enum checkin_source { alarm; usage; location; proof; manual }
Enum proof_status { pending; approved; rejected }
Enum tx_type { deposit; withdrawal; stake_lock; stake_release; penalty; reward; donation }
Enum tx_method { crypto; fiat; internal }
Enum tx_status { pending; confirmed; failed }
Enum escrow_state { none; pending; active; succeeded; failed_locked; claimed; expired; cancelled }
Enum notification_type { system; goal_created; goal_invite; goal_result; friend_request; friend_accepted; proof_review; wallet }
Enum pet_mood { idle; happy; sad }

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email citext [not null, unique]
  username citext [unique, note: '3-24 letras, dígitos o _']
  display_name varchar(60) [not null]
  avatar_url text
  auth_provider auth_provider [not null, default: 'dev']
  provider_subject varchar(255)
  wallet_address varchar(42) [note: '0x + 40 hex']
  chain varchar(32) [not null, default: 'avalanche-fuji']
  location_label varchar(120)
  timezone varchar(64) [not null, default: 'UTC']
  locale varchar(10) [not null, default: 'en']
  onboarding_completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (auth_provider, provider_subject) [unique]
  }
}

Table user_settings {
  user_id uuid [pk, ref: - users.id]
  theme theme_id [not null, default: 'acid']
  haptics boolean [not null, default: true]
  show_seconds boolean [not null, default: true]
  reminders boolean [not null, default: true]
  vibration boolean [not null, default: true]
  updated_at timestamptz [not null, default: `now()`]
}

Table devices {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  install_id varchar(64) [not null]
  platform device_platform [not null, default: 'android']
  model varchar(80)
  os_version varchar(40)
  app_version varchar(20)
  notifications_granted boolean [not null, default: false]
  exact_alarm_granted boolean [not null, default: false]
  usage_access_granted boolean [not null, default: false]
  camera_granted boolean [not null, default: false]
  location_access location_access [not null, default: 'none']
  last_seen_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, install_id) [unique]
  }
}

Table friendships {
  id uuid [pk, default: `gen_random_uuid()`]
  requester_id uuid [not null, ref: > users.id]
  addressee_id uuid [not null, ref: > users.id]
  status friendship_status [not null, default: 'pending']
  created_at timestamptz [not null, default: `now()`]
  responded_at timestamptz

  Note: 'Una fila por pareja (índice único sobre LEAST/GREATEST de ambos ids).'
  indexes {
    (addressee_id, status)
  }
}

Table goals {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_id uuid [not null, ref: > users.id]
  kind goal_kind [not null]
  title varchar(80) [not null]
  description text
  status goal_status [not null, default: 'active']
  stake_amount numeric(18,6) [not null, note: '> 0']
  currency varchar(10) [not null, default: 'USDC']
  start_date date [not null, default: `CURRENT_DATE`]
  end_date date [not null, note: '>= start_date']
  repeat_days "smallint[]" [not null, note: '0 = domingo … 6 = sábado']
  notifications_enabled boolean [not null, default: true]
  max_attempts smallint [not null, default: 1, note: 'fallos tolerados, 1-10']
  extra_lock_days smallint [not null, default: 7]
  dev_tip_percent numeric(5,2) [not null, default: 0]
  is_group boolean [not null, default: false]
  group_mode group_mode [note: 'obligatorio si is_group']
  escrow_tx_hash varchar(66) [note: 'createGoal: transacción que bloqueó el stake']
  escrow_state escrow_state [not null, default: 'none']
  escrow_contract varchar(42)
  escrow_chain_id integer
  escrow_goal_id bigint [note: 'id dentro del contrato; único por contrato']
  escrow_start_at timestamptz
  escrow_end_at timestamptz
  escrow_unlock_at timestamptz
  escrow_metadata_hash varchar(66)
  escrow_resolve_tx_hash varchar(66)
  escrow_claim_tx_hash varchar(66)
  escrow_evidence jsonb
  escrow_error text
  escrow_attempts smallint [not null, default: 0]
  resolved_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (owner_id, status)
  }
}

Table goal_alarm_settings {
  goal_id uuid [pk, ref: - goals.id]
  target_time time [not null]
  reaction_seconds smallint [not null, default: 60, note: '10-900']
  sound_title varchar(80)
  sound_uri text
  vibration_enabled boolean [not null, default: true]
}

Table goal_app_timer_settings {
  goal_id uuid [pk, ref: - goals.id]
  app_package varchar(160) [not null]
  app_name varchar(80) [not null]
  max_daily_minutes smallint [not null, note: '1-1440']
}

Table goal_location_settings {
  goal_id uuid [pk, ref: - goals.id]
  place_label varchar(120) [not null]
  latitude "double precision" [not null]
  longitude "double precision" [not null]
  radius_m integer [not null, default: 150, note: '25-5000']
  arrive_by time [not null]
}

Table goal_ai_settings {
  goal_id uuid [pk, ref: - goals.id]
  prompt text [not null]
  verifier goal_verifier [not null, default: 'ai']
  verifier_user_id uuid [ref: > users.id, note: 'ON DELETE SET NULL: sin juez, decide la IA']
}

Table goal_participants {
  goal_id uuid [not null, ref: > goals.id]
  user_id uuid [not null, ref: > users.id]
  role participant_role [not null, default: 'participant']
  status participant_status [not null, default: 'invited']
  stake_amount numeric(18,6) [not null, default: 0, note: 'lo que aún tiene en custodia']
  invited_at timestamptz [not null, default: `now()`]
  responded_at timestamptz

  indexes {
    (goal_id, user_id) [pk]
    (user_id, status)
  }
}

Table goal_checkins {
  id uuid [pk, default: `gen_random_uuid()`]
  goal_id uuid [not null, ref: > goals.id]
  user_id uuid [not null, ref: > users.id]
  scheduled_for date [not null, note: 'día local del usuario']
  occurred_at timestamptz [not null, default: `now()`]
  result checkin_result [not null]
  source checkin_source [not null]
  measured_value numeric(12,2)
  measured_unit varchar(16)
  latitude "double precision"
  longitude "double precision"
  details jsonb [not null, default: '{}']

  indexes {
    (goal_id, user_id, scheduled_for) [unique, note: 'un veredicto por día']
    (user_id, occurred_at)
  }
}

Table proofs {
  id uuid [pk, default: `gen_random_uuid()`]
  goal_id uuid [not null, ref: > goals.id]
  user_id uuid [not null, ref: > users.id]
  checkin_id uuid [ref: > goal_checkins.id]
  media_url text [not null]
  note text
  status proof_status [not null, default: 'pending']
  verifier goal_verifier [not null, default: 'ai']
  reviewer_id uuid [ref: > users.id]
  verdict_reason text
  created_at timestamptz [not null, default: `now()`]
  reviewed_at timestamptz

  indexes {
    (goal_id, created_at)
    (reviewer_id, status)
  }
}

Table app_usage_samples {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  app_package varchar(160) [not null]
  app_name varchar(80) [not null]
  usage_date date [not null]
  foreground_minutes integer [not null, note: '0-1440']
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, app_package, usage_date) [unique]
  }
}

Table wallet_transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  goal_id uuid [ref: > goals.id]
  type tx_type [not null]
  method tx_method [not null, default: 'internal']
  amount numeric(18,6) [not null, note: 'siempre > 0; el signo lo da type']
  currency varchar(10) [not null, default: 'USDC']
  status tx_status [not null, default: 'confirmed']
  chain varchar(32)
  tx_hash varchar(66)
  reference_code varchar(16) [not null, unique, note: 'WF-XXXXXXXXXX, generado por la base']
  note varchar(160)
  created_at timestamptz [not null, default: `now()`]
  confirmed_at timestamptz

  indexes {
    (user_id, created_at)
    goal_id
  }
}

Table notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  type notification_type [not null, default: 'system']
  title varchar(120) [not null]
  body text [not null, default: '']
  data jsonb [not null, default: '{}']
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at)
  }
}

Table pets {
  user_id uuid [pk, ref: - users.id]
  name varchar(24) [not null, default: 'Will']
  mood pet_mood [not null, default: 'idle']
  energy smallint [not null, default: 68, note: '0-100']
  streak integer [not null, default: 0]
  best_streak integer [not null, default: 0]
  last_fed_at timestamptz
  updated_at timestamptz [not null, default: `now()`]
}
